{
  "name": "@dsh-external/dsh-session-recap",
  "version": "0.1.1",
  "description": "Session recap plugin for DeepSeek Harness (automatic away recaps)",
  "author": "DDDFXYqiming",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDFXYqiming/dsh-session-recap.git"
  },
  "homepage": "https://github.com/DDDFXYqiming/dsh-session-recap#readme",
  "bugs": {
    "url": "https://github.com/DDDFXYqiming/dsh-session-recap/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "session",
    "session-recap",
    "away-summary",
    "web"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "node scripts/build.mjs --no-emit",
    "build:client": "node scripts/build.mjs --client-only",
    "test": "node test/self-check.mjs",
    "prepare": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-brand": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-commands": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-timeout": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.0.0",
    "react": "^18.2.0",
    "typescript": "^5.9.0"
  }
}
